# Copy to .env for local use. Azure uses App Service environment variables.
# Keep .env private. This example contains no working credentials.
REALTIME_ENABLED=false
EVENTHUB_AUTH_MODE=connection_string
EVENTHUB_CONSUMER_GROUP=laundry-web
DEVICE_ID=laundry-esp-paid
TELEMETRY_STALE_SECONDS=30
EVENTHUB_CONNECTION_STRING=
TABLE_ACCOUNT_URL=https://YOUR_STORAGE_ACCOUNT.table.core.windows.net
TABLE_NAME=LaundryTelemetry
# 선택 사항: 기본은 EVENTHUB_CONNECTION_STRING의 EntityPath
# HISTORY_SOURCE=YOUR_PAID_HUB_EVENTHUB_PATH
STORAGE_ACCOUNT=YOUR_STORAGE_ACCOUNT
STORAGE_CONTAINER=telemetry

# 알림 설정 (서버 전용). 값이 없으면 이 기능만 비활성화됨.
# scripts/notification_secrets.py로 숫자 4자리 공통 비밀번호 hash/서명 키 생성.
NOTIFICATION_SECRET_KEY=
NOTIFICATION_PASSWORD_HASH=
NOTIFICATION_RECIPIENTS_JSON=[{"id":"wally","name":"Wally","phone":"+447700900001"},{"id":"flatmate-a","name":"Flatmate A","phone":"+447700900002"},{"id":"flatmate-b","name":"Flatmate B","phone":"+447700900003"}]
# 위 번호는 예시. 실제 번호로 교체. 브라우저에는 id/name만 전달됨.
# Azure는 WEBSITE_HOSTNAME 감지 시 무조건 Blob 사용, 로컬은 instance/notifications.json.
NOTIFICATION_STORAGE_ACCOUNT=YOUR_STORAGE_ACCOUNT
NOTIFICATION_CONTAINER=laundry-notifications
# 로컬 HTTP에서만 false. Azure에서는 항상 Secure cookie 강제.
NOTIFICATION_COOKIE_SECURE=false
# 완료 감지 연결됨. 실제 발송 준비가 되면 true; 기본은 false.
SMS_ENABLED=false
# 나중에 필요. 수신자 선택 기능만 쓸 때는 없어도 됨.
PURESMS_API_KEY=
PURESMS_SENDER=

# Azure deployment uses function; local standalone experiments may use web.
CYCLE_DETECTOR_BACKEND=function

# Default page language; ?lang=kor or ?lang=eng overrides it for one page.
UI_LANGUAGE=kor
